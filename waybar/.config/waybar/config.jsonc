{
  "layer": "top",
  "reload_on_style_change": true,
  "position": "top",
  "spacing": 10,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 0,

  "modules-left": [
    "custom/icon",
    "hyprland/window",
    "mpris",
    "custom/notification"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "wireplumber",
    "backlight",
    "tray",
    "clock",
    "battery"
  ],

  "custom/icon": {
    "format": ""
  },

  "hyprland/window": {
    "separate-outputs": true,
    "format": "{class}",
    "rewrite": {
      "": "Brizotti",
      "kitty": "Brizotti",
      "vesktop": "Discord",
      "zen": "Browser"
    }
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "i",
      "2": "ii",
      "3": "iii",
      "4": "iv",
      "5": "v",
      "6": "vi",
      "7": "vii",
      "8": "viii",
      "9": "ix",
      "10": "x"
    }
  },

  // Módulo de Rede / Wi-Fi
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Conectado",
    "format-linked": "󰈀 {ifname} (Sem IP)",
    "format-disconnected": "󰤭 Desconectado",
    "tooltip-format-wifi": "Sinal: {signalStrength}% | IP: {ipaddr}",
    "tooltip-format-ethernet": "Interface: {ifname} | IP: {ipaddr}",
    "tooltip-format-disconnected": "Sem conexão de rede",
    "on-click": "kitty --class impala-float -e impala"
  },

  // Módulo de Bluetooth
  "bluetooth": {
    "format": "󰂯 {status}",
    "format-disabled": "󰂲 Desativado",
    "format-off": "󰂲 Desligado",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} dispositivo(s) conectado(s)",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} dispositivo(s) conectado(s):\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },

  // Módulo de Volume
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Mute",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  // Módulo de Brilho
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  // Módulo de Bateria
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% 󰚥",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5,
    "show-passive-items": true
  },

  "clock": {
    "format": "<span></span>  {:%H:%M}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<span color='#eed49f'><b>{}</b></span>"
      }
    }
  },

  // Módulo de Música
  "mpris": {
    "format": "󰋋 {player_icon} {artist} - {title}",
    "format-paused": "󰏤 {status_icon} {artist} - {title}",
    "player-icons": {
      "default": "󰎆",
      "mpd": "󰎆"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 30,
    "interval": 1
  },

  // Módulo de Notificações
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup>󰰔</sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup>󰰔</sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup>󰰔</sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup>󰰔</sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}